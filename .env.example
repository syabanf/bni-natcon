# =============================================================
# BNI Natcon 2026 — Digital Stamp
# Salin file ini ke `.env` lalu sesuaikan:  cp .env.example .env
# Semua variabel punya default aman untuk development — `.env`
# kosong pun tetap jalan. `.env` di-gitignore (jangan di-commit).
#
# Dipakai oleh: `docker compose up` (root) dan API Go (`go run`).
# =============================================================

# ---- Aplikasi -----------------------------------------------
# production => API menolak start dengan JWT_SECRET default
APP_ENV=development

# WAJIB diganti di production (mis. hasil `openssl rand -hex 32`)
JWT_SECRET=dev-secret-change-me

# Password semua akun demo hasil seeding
SEED_PASSWORD=natcon2026

# ---- API (go run ./backend/cmd/api) -------------------------
# Alamat listen API saat dijalankan langsung (bukan via Docker).
# Lokal: port 8080 sering terpakai — pakai :8081 (samakan dengan
# VITE_API_PROXY di frontend/.env.local & admin/.env.local).
ADDR=:8080

# Koneksi PostgreSQL saat API dijalankan langsung.
DATABASE_URL=postgres://natcon:natcon@localhost:5432/natcon?sslmode=disable

# Origin yang diizinkan CORS (pisahkan dengan koma).
# Default sudah mencakup dev server Vite (5173/5174).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---- Docker Compose -----------------------------------------
# Kredensial & nama database container Postgres.
DB_USER=natcon
DB_PASSWORD=natcon
DB_NAME=natcon

# Port host yang dipublikasikan tiap service.
DB_PORT=5432
API_PORT=8090
FRONTEND_PORT=8088
ADMIN_PORT=8089

# URL admin panel yang dituju tile "Admin Dashboard" di app
# peserta (di-bake saat build image frontend).
VITE_ADMIN_URL=http://localhost:8089
