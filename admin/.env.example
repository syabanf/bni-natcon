# Admin Panel — salin ke `.env.local`:
#   cp admin/.env.example admin/.env.local
# `.env.local` di-gitignore; semua variabel opsional (ada default).

# Target proxy /api milik dev server Vite.
# Default http://localhost:8080 — ganti bila API jalan di port lain
# (mis. :8081 karena 8080 terpakai).
VITE_API_PROXY=http://localhost:8080

# Origin API untuk build yang di-host di static hosting (Vercel/Netlify/S3),
# yang tidak punya /api untuk di-proxy. Kosongkan untuk dev (proxy Vite) dan
# untuk image Docker (nginx yang mem-proxy /api ke container API).
# Contoh: VITE_API_URL=https://api.natcon.example.com
# Wajib didaftarkan juga di ALLOWED_ORIGINS milik API.
VITE_API_URL=
