{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/door/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/door/brand/(.*)", "destination": "/brand/$1" },
    { "source": "/door/(.*)", "destination": "/index.html" }
  ],
  "redirects": [{ "source": "/", "destination": "/door/login", "permanent": false }]
}
