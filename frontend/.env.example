# App Peserta & Tenant — salin ke `.env.local`:
#   cp frontend/.env.example frontend/.env.local
# `.env.local` di-gitignore; semua variabel opsional (ada default).

# Target proxy /api milik dev server Vite.
# Default http://localhost:8080 — ganti bila API jalan di port lain
# (mis. :8081 karena 8080 terpakai).
VITE_API_PROXY=http://localhost:8080

# URL admin panel untuk tile "Admin Dashboard" di landing page.
# Default http://localhost:5174 (dev server admin).
VITE_ADMIN_URL=http://localhost:5174
